%{
#include <stdio.h>

int lines = 0;
int tokens = 0;
int identifiers = 0;
int keywords = 0;
int spaces = 0;
%}

keyword    int|float|char|double|if|else|while|for|return
id         [a-zA-Z_][a-zA-Z0-9_]*

%w

{keyword}  { keywords++; tokens++; }
{id}       { identifiers++; tokens++; }
[0-9]+     { tokens++; }
\"([^\\\"]|\\.)*\"  { tokens++; }
[ \t]+     { spaces += yyleng; }
\n         { lines++; spaces++; }
.          { tokens++; }

%%

int yywrap()
{
    return 1;
}

int main()
{
    printf("Enter statement :\n");
    yylex();

    printf("\nCountings -\n");
    printf("Number of lines: %d\n", lines);
    printf("Number of tokens: %d\n", tokens);
    printf("Number of identifiers: %d\n", identifiers);
    printf("Number of keywords: %d\n", keywords);
    printf("Space characters: %d\n", spaces);

    return 0;
}
