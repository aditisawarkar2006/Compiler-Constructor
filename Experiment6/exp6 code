%{
#include <stdio.h>
#include <stdlib.h>
FILE *out;
%}
%%
[0-9]+ {
    int n = atoi(yytext);
    fprintf(out, "%X\n", n);
}
\n      ;
.       ;
%%
int main()
{
    out = fopen("output.txt", "w");

    if(out == NULL)
    {
        printf("File error");
        return 1;
    }

    yyin = fopen("input.txt", "r");
    if(yyin == NULL)
    {
        printf("Input file not found");
        return 1;
    }
    yylex();
    fclose(yyin);
    fclose(out);
    printf("Conversion completed. Check output.txt");
    return 0;
}
int yywrap()
{
    return 1;
}
