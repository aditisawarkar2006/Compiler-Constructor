%{
#include <stdio.h>
int count = 0;
%}

%%
8([0-9]+)?(\.[0-9]+)?([eE][+-]?[0-9]+)?  { count++; }
[ \t\n]+    ;
.           ;
%%

int yywrap()
{
    return 1;
}

int main()
{
    printf("Enter input:\n");
    yylex();

    printf("\nCount of numbers starting with 8 = %d\n", count);

    return 0;
}
